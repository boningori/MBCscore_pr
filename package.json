{
  "name": "minibasket-score",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
